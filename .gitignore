.DS_Store

# Generated by `make <platform>-project` / xcodegen. Never committed: an
# .xcodeproj names your paths and your team id, and the diffs are unreadable.
# Apps/*/project.yml is the checked-in source of truth.
*.xcodeproj
*.xcworkspace

# Build products
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# `.xcarchive`s from `make <port>-archive`. Rebuilt fresh each time, same as
# the .xcodeproj above — nothing in here is source.
build/

# Build counters, one per port, bumped by `make <port>-build`.
#
# Per machine, not per project: a build number here means "the nth build I have
# made of this port", and committing it would mean every build produces a diff
# and two people building the same commit disagree about which build it is.
Apps/*/build.number
