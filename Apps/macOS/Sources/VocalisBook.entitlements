<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sandbox keys are here as well as in Config/macOS.xcconfig.

	     ENABLE_APP_SANDBOX and ENABLE_OUTGOING_NETWORK_CONNECTIONS make Xcode
	     synthesise these, and that is how this app has always got them. Whether
	     it keeps synthesising once CODE_SIGN_ENTITLEMENTS points at a real file
	     is the question, and the failure if it does not is the one already
	     described in project.yml: a sandboxed app with no network permission,
	     where every request fails and sign-in reports a transport error with no
	     explanation.

	     Stating them twice costs nothing — the values agree — and not stating
	     them costs an afternoon. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- The push capability, without which the registration fails.

	     `CKSyncEngine` learns that another device changed something from a
	     silent push, and asking for those needs three things: this key, the
	     `remote-notification` background mode, and the call to
	     `registerForRemoteNotifications()`. The code had the last two and not
	     this one, so registration failed at launch and no push has ever
	     arrived — sync has been running entirely on its own poll, which is
	     why it worked at all and why it was never instant.

	     `development` here, and Xcode rewrites it to `production` when it
	     signs a distribution build. Writing `production` by hand breaks every
	     development build instead, which is the more common mistake and the
	     harder one to notice. -->
	<!-- The Mac spells the same key differently. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>

	<!-- CloudKit, for the data Plex cannot hold. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.se.kladhest.vocalisbook</string>
	</array>
</dict>
</plist>
